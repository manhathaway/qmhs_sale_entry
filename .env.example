# Less Annoying CRM
LACRM_API_KEY=your_lacrm_api_key_here
PORT=5000

# Session and auth
SESSION_SECRET=replace_with_a_long_random_secret
REDIS_URL=redis://localhost:6379
AUTH_USERNAME=your_username
SESSION_COOKIE_SAME_SITE=strict
# Optional (for subdomain sharing): SESSION_COOKIE_DOMAIN=.yourdomain.com
# Optional session lifetime in milliseconds (default 12h): SESSION_MAX_AGE_MS=43200000
# Optional when behind reverse proxy/load balancer (default 1 in prod): TRUST_PROXY=1
# Optional CORS allow-list for external frontend origins (comma-separated)
# ALLOWED_ORIGINS=https://your-site.netlify.app,https://www.yourdomain.com

# Preferred: bcrypt hash for the password
# Generate with: node -e "import bcrypt from 'bcryptjs'; bcrypt.hash('your_password', 12).then(console.log)"
AUTH_PASSWORD_HASH=

# Optional fallback (development only, never production)
# AUTH_PASSWORD=your_plain_text_password
